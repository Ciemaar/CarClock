#!/bin/sh

echo "Running ktlintCheck before commit..."

# Stash unstaged changes to only check what's being committed
git stash -q --keep-index

# Run Spotless Check (Kotlin & Markdown formatting)
./gradlew spotlessCheck
SPOTLESS_RESULT=$?

# Run Detekt (Kotlin Static Analysis)
./gradlew detekt
DETEKT_RESULT=$?

# Run Dokka Check (Enforce KDoc presence)
./gradlew dokkaHtml
DOKKA_RESULT=$?

# Unstash the unstaged changes ONLY if we actually stashed something
STASH_COUNT=$(git stash list | wc -l)
if [ "$STASH_COUNT" -gt 0 ]; then
  git stash pop -q
fi

if [ $SPOTLESS_RESULT -ne 0 ]; then
  echo "❌ Spotless formatting check failed! Please fix formatting issues using './gradlew spotlessApply' before committing."
  exit 1
fi

if [ $DETEKT_RESULT -ne 0 ]; then
  echo "❌ Detekt static analysis failed! Please fix the reported Kotlin code smells before committing."
  exit 1
fi

if [ $DOKKA_RESULT -ne 0 ]; then
  echo "❌ Missing Kotlin Documentation! Please add KDoc comments to any new public functions or classes."
  exit 1
fi

echo "✅ Formatting and Documentation checks passed!"
exit 0
